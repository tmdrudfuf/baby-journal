# Copy to .env (npm run bootstrap does this). Never commit real values.

# --- App (public, bundled into the client) ---
# Local: values printed by `npm run db:start`. Staging: `npx supabase projects api-keys --project-ref stdlwvahmexetlrrzpld`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Edge functions (server-only; set via `supabase secrets set` for staging/prod) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baby-journal-media-local
